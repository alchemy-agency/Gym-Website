# ---------------------------------------------------------------------------
# Sam's Body Shop HB - environment variables
# Copy this file to `.env.local` for local dev, then add the same keys in
# Vercel: Project -> Settings -> Environment Variables
# ---------------------------------------------------------------------------

# Public site URL. Used for canonical tags, sitemap and JSON-LD.
# On Vercel, set this to the production domain (e.g. https://www.samsbodyshophb.com)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Google Ads / Analytics -------------------------------------------------
# Sofia: paste the Google Ads conversion ID here (format: AW-XXXXXXXXXXX)
# and the Google Analytics 4 measurement ID (format: G-XXXXXXXXXX).
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_GA4_ID=

# Google Ads conversion *labels* for the two lead actions.
# Google Ads -> Goals -> Conversions -> your action -> "Tag setup" -> the label
# is the part after the slash in send_to, e.g. "AW-123456789/AbC-D_efGh"
NEXT_PUBLIC_GADS_LABEL_FREE_SESSION=
NEXT_PUBLIC_GADS_LABEL_MEMBERSHIP=

# --- Lead delivery ----------------------------------------------------------
# Where form submissions are sent. A POST with a JSON body is made to this URL.
# Works out of the box with Zapier / Make / n8n catch hooks, Formspree,
# Slack incoming webhooks, or your own endpoint.
# If left empty, submissions are logged to the Vercel function logs instead.
LEAD_WEBHOOK_URL=

# Optional: also email leads via Resend (https://resend.com)
RESEND_API_KEY=
LEAD_EMAIL_TO=sam@samsbodyshop.com
LEAD_EMAIL_FROM=

# Optional shared secret. If set, every lead request must include a matching
# `x-lead-token` header (handled automatically by the server action).
LEAD_SHARED_SECRET=
